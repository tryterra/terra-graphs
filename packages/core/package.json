{
  "name": "terra-graphs",
  "version": "2.0.0",
  "description": "Embed Terra health graphs in your app, without an iframe",
  "keywords": ["terra", "health", "fitness", "wearables", "graphs", "charts", "web-component"],
  "homepage": "https://docs.tryterra.co/graphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryterra/terra-graphs.git",
    "directory": "packages/core"
  },
  "bugs": { "url": "https://github.com/tryterra/terra-graphs/issues" },
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/index.js", "./dist/index.cjs"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  }
}
