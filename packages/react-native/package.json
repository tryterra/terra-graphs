{
  "name": "terra-graphs-react-native",
  "version": "0.1.0",
  "description": "Embed Terra health graphs in a React Native app, drawn natively",
  "keywords": [
    "terra",
    "health",
    "fitness",
    "wearables",
    "graphs",
    "charts",
    "react-native",
    "expo"
  ],
  "homepage": "https://docs.tryterra.co/graphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryterra/terra-graphs.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/tryterra/terra-graphs/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js",
      "require": "./dist/stats.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "extract": "node scripts/extract-option-builder.mjs",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "echarts": "5.5.1"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "@wuba/react-native-echarts": ">=3",
    "react": ">=17",
    "react-native": ">=0.70",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
