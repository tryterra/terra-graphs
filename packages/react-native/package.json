{
  "name": "@tryterra/graphs-react-native",
  "version": "1.0.0",
  "description": "Embed Terra health graphs in a React Native app, drawn natively",
  "keywords": [
    "terra",
    "health",
    "fitness",
    "wearables",
    "graphs",
    "charts",
    "react-native",
    "expo"
  ],
  "homepage": "https://docs.tryterra.co/graphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryterra/terra-graphs.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/tryterra/terra-graphs/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skia": {
      "types": "./dist/skia.d.ts",
      "default": "./dist/skia.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "extract": "node scripts/extract-option-builder.mjs",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "notices": "node scripts/generate-notices.mjs"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "react": ">=17",
    "react-native": ">=0.70",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@wuba/react-native-echarts": "3.1.1",
    "echarts": "5.5.1",
    "zrender": "5.6.0"
  }
}
